{
  "name": "@flow/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Truy cập dữ liệu: schema Drizzle (core, cf), migration SQL, RLS, withWorkspace(). Chỉ được phụ thuộc @flow/shared.",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./auth-db": "./src/auth-db.ts",
    "./schema/core": "./src/schema/core/index.ts",
    "./schema/cf": "./src/schema/cf/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/cli/migrate.ts",
    "db:repair-dev": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/cli/repair-dev.ts",
    "db:migrate:staging": "tsx src/cli/migrate-staging.ts",
    "db:test:reset": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/cli/test-reset.ts",
    "db:check-rls": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/cli/check-rls.ts"
  },
  "dependencies": {
    "@flow/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
