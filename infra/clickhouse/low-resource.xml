<clickhouse>
  <!-- Cấu hình tiết kiệm RAM/đĩa cho môi trường dev/staging nhỏ (Langfuse không cần các bảng log hệ thống này). -->
  <logger>
    <level>warning</level>
    <console>true</console>
  </logger>
  <query_thread_log remove="1"/>
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <mark_cache_size>268435456</mark_cache_size>
  <max_server_memory_usage_to_ram_ratio>0.85</max_server_memory_usage_to_ram_ratio>
</clickhouse>
