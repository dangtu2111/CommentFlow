# Tên biến của .env.cf-dev trên MÁY ẢO (project cf-dev). Chỉ có tên + mô tả, KHÔNG có giá trị thật.
# File thật được sinh bằng scripts/cf-dev-env-init.sh (openssl, chmod 600) và không bao giờ rời máy ảo.
# (Tên file KHÔNG có dấu chấm đầu — quy ước vĩnh viễn, xem AGENTS.md mục Lệnh. `.env` thật do chủ dự án sinh bằng infra/scripts/print-dev-env.sh.)

# --- Không phải bí mật ---
CF_DATABASES=            # danh sách DB ứng dụng, cách nhau dấu cách (dev: "cf_dev cf_test")
CACHE_NAMESPACE=         # tiền tố khóa cache của LiteLLM (dev: "dev:litellm")
LAN_HOST=                # IP LAN của máy phụ (192.168.1.124)
LANGFUSE_PUBLIC_URL=     # URL người dùng mở Langfuse, phải khớp trình duyệt (http://<LAN_HOST>:3100)
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=

# --- Bí mật (sinh ngẫu nhiên) ---
POSTGRES_PASSWORD=       # superuser Postgres (chỉ dùng nội bộ container/khởi tạo)
CF_OWNER_PASSWORD=       # role cf_owner: chạy migration, sở hữu bảng
CF_APP_PASSWORD=         # role cf_app: ứng dụng, không BYPASSRLS
CF_AUTH_PASSWORD=        # role cf_auth: adapter Better Auth, chỉ bảng xác thực (thêm vào volume cũ bằng `pnpm cf:dev add-auth-role`)
CF_WORKER_PASSWORD=      # role cf_worker: CHỈ worker (hệ thống + đọc token, ADR 011); thêm vào volume cũ bằng `pnpm cf:dev add-worker-role`
LITELLM_DB_PASSWORD=     # role litellm (DB litellm)
LANGFUSE_DB_PASSWORD=    # role langfuse (DB langfuse)
VALKEY_PASSWORD=
CLICKHOUSE_PASSWORD=
S3_ACCESS_KEY=           # SeaweedFS S3 (Langfuse)
S3_SECRET_KEY=
LITELLM_MASTER_KEY=      # khóa quản trị LiteLLM
LITELLM_SALT_KEY=        # khóa mã hóa dữ liệu nhạy cảm trong DB của LiteLLM
GEMINI_API_KEY=          # khóa Google AI Studio/Gemini (tùy chọn): bật model cf-classify/cf-draft trong infra/litellm/config.yaml
NEXTAUTH_SECRET=         # Langfuse
LANGFUSE_SALT=           # Langfuse
LANGFUSE_ENCRYPTION_KEY= # Langfuse, 64 ký tự hex
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=   # khóa dự án Langfuse (LiteLLM dùng để gửi trace)
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_PASSWORD=        # mật khẩu đăng nhập giao diện Langfuse (xem trên máy ảo)
