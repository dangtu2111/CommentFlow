# Tên biến của .env.cf-staging trên MÁY ẢO (project cf-staging). Chỉ có tên + mô tả, KHÔNG có giá trị thật.
# File thật không bao giờ commit và không rời máy ảo. Dùng cùng các biến nền của infra/env.cf-dev.example
# (POSTGRES_PASSWORD, CF_OWNER_PASSWORD, CF_APP_PASSWORD, CF_AUTH_PASSWORD, CF_WORKER_PASSWORD, VALKEY_PASSWORD, LITELLM_*, LANGFUSE_*, S3_*, CLICKHOUSE_PASSWORD…)
# vì docker-compose.staging.yml chạy chồng lên docker-compose.yml. Dưới đây chỉ liệt kê phần THÊM cho web/worker/tunnel.

# --- Không phải bí mật ---
CF_DATABASES=            # DB ứng dụng của staging, một tên (docs/15 §2: "commentflow"); LƯU Ý: không dùng tên cf_dev/cf_test
CF_APP_DATABASE=         # cùng tên với CF_DATABASES (web/worker kết nối vào DB này)
CF_STAGING_DB_PORT=      # cổng Postgres publish ở 127.0.0.1 của máy ảo cho runner migrate (mặc định 5434); chỉ loopback
IMAGE_TAG=             # thẻ image (git sha) do deploy-staging đặt; trống = "local"
BETTER_AUTH_URL=         # URL gốc công khai của web (https://<tên miền staging>); dựng link trong thư
CLIENT_IP_SOURCE=        # none (mặc định) hoặc cf-connecting-ip — CHỈ đặt cf-connecting-ip khi web chỉ nhận lưu lượng qua cloudflared
LOG_LEVEL=               # fatal|error|warn|info|debug|trace (mặc định info)
SMTP_HOST=               # máy chủ SMTP thật (staging không có Mailpit)
SMTP_PORT=
SMTP_FROM=               # địa chỉ người gửi, ví dụ "CommentFlow AI <no-reply@...>"
SMTP_SECURE=             # true|false
META_APP_ID=             # Meta App dev (staging có Meta App riêng — docs/15 §5)

# --- Bí mật (sinh ngẫu nhiên / lấy từ nhà cung cấp; chỉ trên máy ảo hoặc GitHub secret) ---
BETTER_AUTH_SECRET=      # khóa ký cookie phiên, tối thiểu 32 ký tự (openssl rand -hex 32)
TOKEN_ENC_KEYS=          # v1:<openssl rand -hex 32>[,v2:…] — khóa mã hóa token kênh (docs/13 §5)
SMTP_USER=
SMTP_PASS=
META_APP_SECRET=         # xác minh chữ ký webhook + đổi token
META_WEBHOOK_VERIFY_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN= # token Cloudflare Tunnel (chỉ khi bật `--profile tunnel`; chưa có tên miền thì để trống)

# --- Dịch vụ AI/kho ảnh dùng chung với cf-dev trên CÙNG máy ảo (mặc định qua host.docker.internal; chỉ ghi đè khi khác) ---
LITELLM_BASE_URL=        # mặc định http://host.docker.internal:4000 (LiteLLM của cf-dev)
CLASSIFY_LLM_MODEL=      # mặc định cf-classify
DRAFT_LLM_MODEL=         # mặc định cf-draft
REWRITE_LLM_MODEL=       # mặc định cf-classify
DISTILL_LLM_MODEL=       # mặc định cf-draft
CAPTION_LLM_MODEL=       # mặc định cf-draft (AI gợi ý caption/hashtag trong Biên tập)
ML_URL=                  # mặc định http://host.docker.internal:8001 (dịch vụ ml của cf-dev)
ML_EMBED_ENABLED=        # mặc định true
ML_RERANK_ENABLED=       # mặc định true
MEDIA_S3_ENDPOINT=       # mặc định http://host.docker.internal:8333 (SeaweedFS của cf-dev)
MEDIA_S3_BUCKET=         # mặc định cf-media-staging (tạo bucket này trước; KHÁC bucket cf-media của dev)
FB_OAUTH_ENABLED=    # true = bật nút "Kết nối kênh" ở web (cần META_APP_ID/SECRET, META_OAUTH_REDIRECT_URL, TOKEN_ENC_KEYS); mặc định false
META_OAUTH_REDIRECT_URL=    # https://<tên-miền>/api/channels/facebook/callback (phải khớp Valid OAuth Redirect URIs ở Meta)
FB_LOGIN_CONFIG_ID=    # tùy chọn: Configuration ID của Facebook Login for Business
FB_CONNECTOR_ENABLED=    # true = bật connector Facebook ở worker (cần META_APP_ID/SECRET, TOKEN_ENC_KEYS); mặc định false
FB_PUBLISH_ENABLED=      # true = cho phép lên lịch/đăng bài lên Fanpage (web + worker); mặc định false

# --- Bí mật dùng chung (thêm bằng infra/scripts/staging-add-shared-secrets.sh trên máy ảo, KHÔNG gõ tay/dán vào chat) ---
LITELLM_API_KEY=         # khóa ảo LiteLLM RIÊNG cho staging (script tạo qua LITELLM_MASTER_KEY của cf-dev, kèm trần ngân sách)
MEDIA_S3_ACCESS_KEY=     # khóa S3 của SeaweedFS (cùng khóa S3_ACCESS_KEY của cf-dev)
MEDIA_S3_SECRET_KEY=
