# Tên biến của .env.cf-staging trên MÁY ẢO (project cf-staging). Chỉ có tên + mô tả, KHÔNG có giá trị thật.
# File thật không bao giờ commit và không rời máy ảo. Dùng cùng các biến nền của infra/env.cf-dev.example
# (POSTGRES_PASSWORD, CF_OWNER_PASSWORD, CF_APP_PASSWORD, CF_AUTH_PASSWORD, VALKEY_PASSWORD, LITELLM_*, LANGFUSE_*, S3_*, CLICKHOUSE_PASSWORD…)
# vì docker-compose.staging.yml chạy chồng lên docker-compose.yml. Dưới đây chỉ liệt kê phần THÊM cho web/worker/tunnel.

# --- Không phải bí mật ---
CF_DATABASES=            # DB ứng dụng của staging, một tên (docs/15 §2: "commentflow"); LƯU Ý: không dùng tên cf_dev/cf_test
CF_APP_DATABASE=         # cùng tên với CF_DATABASES (web/worker kết nối vào DB này)
IMAGE_TAG=               # thẻ image (git sha) do deploy-staging đặt; trống = "local"
BETTER_AUTH_URL=         # URL gốc công khai của web (https://<tên miền staging>); dựng link trong thư
CLIENT_IP_SOURCE=        # none (mặc định) hoặc cf-connecting-ip — CHỈ đặt cf-connecting-ip khi web chỉ nhận lưu lượng qua cloudflared
LOG_LEVEL=               # fatal|error|warn|info|debug|trace (mặc định info)
SMTP_HOST=               # máy chủ SMTP thật (staging không có Mailpit)
SMTP_PORT=
SMTP_FROM=               # địa chỉ người gửi, ví dụ "CommentFlow AI <no-reply@...>"
SMTP_SECURE=             # true|false
META_APP_ID=             # Meta App dev (staging có Meta App riêng — docs/15 §5)

# --- Bí mật (sinh ngẫu nhiên / lấy từ nhà cung cấp; chỉ trên máy ảo hoặc GitHub secret) ---
BETTER_AUTH_SECRET=      # khóa ký cookie phiên, tối thiểu 32 ký tự (openssl rand -hex 32)
TOKEN_ENC_KEYS=          # v1:<openssl rand -hex 32>[,v2:…] — khóa mã hóa token kênh (docs/13 §5)
SMTP_USER=
SMTP_PASS=
META_APP_SECRET=         # xác minh chữ ký webhook + đổi token
META_WEBHOOK_VERIFY_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN= # token Cloudflare Tunnel (chỉ khi bật `--profile tunnel`; chưa có tên miền thì để trống)
