# Máy code — chỉ những gì web/worker cần. Sao chép thành .env rồi tự điền giá trị (KHÔNG commit).
# Mật khẩu nằm trong .env.cf-dev trên máy ảo; không chép cả file đó về đây.
# Máy ảo cf-dev: 192.168.1.124 (qua portproxy Windows → 10.10.10.10).
# (Tên file KHÔNG có dấu chấm đầu — quy ước vĩnh viễn, xem AGENTS.md mục Lệnh. `.env` thật do chủ dự án sinh bằng infra/scripts/print-dev-env.sh.)

APP_ENV=dev                 # dev | test | ci — script migrate chỉ chạy với các giá trị này
LOG_LEVEL=info
WORKER_PORT=3001

# Postgres (cổng 5433). Ứng dụng dùng cf_app; migration/tạo lại schema test dùng cf_owner.
DATABASE_URL=postgresql://cf_app:<CF_APP_PASSWORD>@192.168.1.124:5433/cf_dev
DATABASE_ADMIN_URL=postgresql://cf_owner:<CF_OWNER_PASSWORD>@192.168.1.124:5433/cf_dev
# Role cf_auth: CHỈ module auth của saas-core dùng (adapter Better Auth); chỉ có quyền trên bảng xác thực
DATABASE_AUTH_URL=postgresql://cf_auth:<CF_AUTH_PASSWORD>@192.168.1.124:5433/cf_dev
# Role cf_worker: CHỈ tiến trình worker dùng (đường "hệ thống" + đọc ciphertext token, ADR 011); web KHÔNG được có biến này
DATABASE_WORKER_URL=postgresql://cf_worker:<CF_WORKER_PASSWORD>@192.168.1.124:5433/cf_dev
TEST_DATABASE_URL=postgresql://cf_app:<CF_APP_PASSWORD>@192.168.1.124:5433/cf_test
TEST_DATABASE_ADMIN_URL=postgresql://cf_owner:<CF_OWNER_PASSWORD>@192.168.1.124:5433/cf_test
TEST_DATABASE_AUTH_URL=postgresql://cf_auth:<CF_AUTH_PASSWORD>@192.168.1.124:5433/cf_test
TEST_DATABASE_WORKER_URL=postgresql://cf_worker:<CF_WORKER_PASSWORD>@192.168.1.124:5433/cf_test
# Chạy song song nhiều nhánh: đặt CF_LANE=a|b|c (biến môi trường, KHÔNG ghi vào file này) để bốn URL test ở trên
# tự trỏ tới cf_test_<làn>. Xem docs/workflows/parallel.md.

# Valkey (cổng 6380). Khóa của dev luôn có tiền tố "dev:" ở phía ứng dụng.
REDIS_URL=redis://:<VALKEY_PASSWORD>@192.168.1.124:6380/0
REDIS_KEY_PREFIX=dev:

# Dịch vụ AI
ML_URL=http://192.168.1.124:8001
LITELLM_BASE_URL=http://192.168.1.124:4000
LITELLM_API_KEY=            # khóa ảo của dev (chỉ model mock-llm, trần 5 USD) — sinh bằng scripts/cf-dev-litellm-key.sh trên máy ảo; KHÔNG dùng master key
LANGFUSE_HOST=http://192.168.1.124:3100

# Thương hiệu (FR-125) — tên thật chưa chốt (Q6); bỏ trống = giá trị tạm "CommentFlow AI", không logo/tên miền
APP_NAME=                   # tên hiển thị (giao diện, thư, app 2FA), tối đa 60 ký tự
APP_LOGO_URL=               # đường dẫn gốc (/brand/logo.svg) hoặc https://…; trống = biểu tượng mặc định
APP_DOMAIN=                 # tên miền công khai, không kèm https://
APP_EMAIL_FROM=             # người gửi đầy đủ, ví dụ: Tên <no-reply@ten-mien>; trống = dựng từ APP_NAME + APP_DOMAIN

# Hộp thư giả Mailpit (chỉ dev): SMTP không xác thực, xem thư ở giao diện web.
SMTP_HOST=192.168.1.124
SMTP_PORT=1025
SMTP_FROM="CommentFlow AI <no-reply@commentflow.local>"   # tùy chọn: bỏ trống thì dùng APP_EMAIL_FROM, hoặc "APP_NAME <no-reply@APP_DOMAIN>"
MAILPIT_URL=http://192.168.1.124:8025
# Production: thêm SMTP_SECURE=true|false, SMTP_USER, SMTP_PASS (nhà cung cấp chưa chọn).

# Web (xác thực). Địa chỉ gốc dùng dựng link trong thư.
# Nguồn IP cho rate limit (ADR 004 §2): none (mặc định; dev/LAN không tin header nào) | cf-connecting-ip (CHỈ APP_ENV=staging,
# sau Cloudflare Tunnel và cổng web không publish). Dev không đặt biến này.
#CLIENT_IP_SOURCE=none
# Kiểm mật khẩu lộ bằng Have I Been Pwned (ADR 004 §3): on (mặc định) | off (CHỈ dev/test/ci; dev không ra internet thì đặt off).
# Luôn còn danh sách mật khẩu phổ biến cục bộ. HIBP lỗi/timeout 2 giây → cho qua + log cảnh báo.
#PWNED_CHECK=off
BETTER_AUTH_URL=http://localhost:3000

# --- KHÔNG đặt ở .env: khóa ký cookie phiên nằm ở .env.local (người dùng tự tạo, không commit; không để trên máy ảo — docs/13 §2) ---
# .env.local được nạp SAU .env (web, worker, script, test) nên chạy lại print-dev-env.sh không làm mất khóa.
#   BETTER_AUTH_SECRET=<openssl rand -hex 32>

# Meta App (FB-OAUTH, WH-INGEST) — CHỈ tên biến: giá trị thật tự đặt trong .env.local (không commit). Hướng dẫn: docs/CAN_BAN_CUNG_CAP.md
META_APP_ID=
META_APP_SECRET=            # dùng đổi token và xác minh chữ ký webhook X-Hub-Signature-256
META_WEBHOOK_VERIFY_TOKEN=  # chuỗi ngẫu nhiên tự chọn, dán cùng giá trị ở Meta khi đăng ký webhook
META_OAUTH_REDIRECT_URL=http://localhost:3000/api/channels/facebook/callback
# Kết nối Facebook (FB-OAUTH): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật; bật thì cần cả META_* và TOKEN_ENC_KEYS bên dưới).
FB_OAUTH_ENABLED=
FB_LOGIN_CONFIG_ID=         # tùy chọn: Configuration ID của Facebook Login for Business (bỏ trống → xin quyền bằng scope)
# Quét bù bình luận (POLLING-BACKFILL, FR-023; worker): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật; bật thì cần META_APP_ID/META_APP_SECRET + TOKEN_ENC_KEYS). Gọi Meta thật — chỉ bật ở staging có Page thử.
POLLING_ENABLED=
# Xóa vĩnh viễn workspace (WORKSPACE-DELETE, FR-094; worker): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật). Bật = job xóa HẾT dữ liệu workspace đã xác nhận 2 bước + hết 7 ngày chờ; không hoàn tác được.
WORKSPACE_DELETE_ENABLED=
# QR chuyển khoản (QR-PAYMENT, FR-091; web): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật). Bật thì cần đủ 3 biến PAYMENT_* bên dưới (thiếu/sai → không hiện QR). Tài khoản nhận tiền do chủ dự án cung cấp (docs/CAN_BAN_CUNG_CAP.md); không gọi dịch vụ ngoài.
QR_PAYMENT_ENABLED=
# Mã BIN ngân hàng nhận (6 chữ số, danh mục NAPAS)
PAYMENT_BANK_BIN=
# Số tài khoản nhận (6–19 chữ số)
PAYMENT_ACCOUNT_NUMBER=
# Tên chủ tài khoản (chỉ để hiển thị cho người chuyển đối chiếu)
PAYMENT_ACCOUNT_NAME=
MESSENGER_CONNECTOR_ENABLED=  # worker: BẬT = dựng bộ gửi tin Messenger thật (MESSENGER-WEBHOOK, FR-014; cửa sổ 24 giờ/7 ngày); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; độc lập với FB_CONNECTOR_ENABLED; bật thì cần META_APP_ID, META_APP_SECRET, TOKEN_ENC_KEYS
TIKTOK_CONNECTOR_ENABLED=   # worker: BẬT = đọc/trả lời bình luận TikTok thật qua TikTok API for Business (TIKTOK-CONNECTOR, FR-015); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; bật thì cần TIKTOK_CLIENT_SECRET, TOKEN_ENC_KEYS
TIKTOK_CLIENT_SECRET=       # worker: khóa bí mật ứng dụng TikTok, chỉ để xác minh chữ ký webhook (cần quyền TikTok API for Business, Q5)
IG_CONNECTOR_ENABLED=       #worker: BẬT = gửi trả lời LẪN ẩn bình luận Instagram thật trên Meta (IG-CONNECTOR, FR-013); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; độc lập với FB_CONNECTOR_ENABLED; bật thì cần META_APP_ID, META_APP_SECRET, TOKEN_ENC_KEYS
FB_CONNECTOR_ENABLED=       # worker: BẬT = cả gửi trả lời LẪN ẩn bình luận thật trên Meta; đăng ký connector Facebook thật (FB-CONNECTOR-REGISTER); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; bật thì cần META_APP_ID, META_APP_SECRET, TOKEN_ENC_KEYS
# Phân loại + tách thông tin bình luận bằng LLM (PIPE-CLASSIFY-EXTRACT, FR-027/145/162): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật; bật thì dùng LITELLM_BASE_URL/LITELLM_API_KEY và tốn tiền LLM).
CLASSIFY_LLM_ENABLED=
CLASSIFY_LLM_MODEL=         # tùy chọn: tên model nhỏ theo cấu hình LiteLLM (mặc định `mock-llm`)
# Soạn trả lời bằng LLM (PIPE-DRAFT, FR-029/138/140/142): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật; bật thì dùng LITELLM_BASE_URL/LITELLM_API_KEY và tốn tiền LLM).
DRAFT_LLM_ENABLED=
DRAFT_LLM_MODEL=            # tùy chọn: tên model soạn theo cấu hình LiteLLM (mặc định `mock-llm`)
# Viết lại câu hỏi theo ngữ cảnh bằng LLM rẻ (PIPE-REWRITE-CTX, FR-137): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật; bật thì tốn tiền LLM).
REWRITE_LLM_ENABLED=
REWRITE_LLM_MODEL=          # tùy chọn: tên model rẻ theo cấu hình LiteLLM (mặc định `mock-llm`)
# Semantic cache LiteLLM (PIPE-CACHE-SEMANTIC-STUB, FR-026): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật); chưa nối pipeline, phần đầy đủ ở GĐ5. Mẫu: infra/litellm/semantic-cache.example.yaml
CACHE_SEMANTIC_ENABLED=
# Khóa ảo LiteLLM theo workspace (AI-VIRTUALKEY, FR-034): cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật); chưa nối nơi dựng client, lưu khóa bền chờ `AI-VIRTUALKEY-DB`. Master key CHỈ dùng để cấp/sửa/thu hồi khóa ảo, không bao giờ để gọi LLM.
LITELLM_VIRTUAL_KEYS_ENABLED=
LITELLM_MASTER_KEY=         # master key LiteLLM (chủ dự án cung cấp; không commit)
LITELLM_VIRTUAL_KEY_DEFAULT_BUDGET_USD=   # ngân sách USD/tháng khi workspace chưa đặt trần
CHANNELS_LIMIT_DEFAULT=     # tùy chọn: số kênh tối đa mỗi workspace (mặc định 1; thay bằng giới hạn gói khi có bảng plans)

# Mã hóa token Page/IG (TOKEN-ENC, docs/13 §5) — CHỈ tên biến: giá trị thật tự đặt trong .env.local (không commit, KHÔNG để trên máy ảo).
# Dạng v1:<64 ký tự hex>,v2:<64 ký tự hex>. Phiên bản cao nhất dùng để mã hóa, các phiên bản cũ chỉ để giải mã (xoay khóa).
#   TOKEN_ENC_KEYS=v1:<openssl rand -hex 32>
TOKEN_ENC_KEYS=

# Khách tiềm năng (LEADS-STORE, FR-082, Q-LDS1) — CHỈ tên biến; cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật; bật thì cần cả hai khóa dưới, thiếu/sai → lỗi cấu hình lúc khởi động). Khóa KHÁC TOKEN_ENC_KEYS, không để trên máy ảo dùng chung.
#   LEADS_ENC_KEYS=v1:<openssl rand -hex 32>   (xoay: thêm v2:…, giữ khóa cũ để giải mã)
#   LEADS_HASH_KEY=<openssl rand -hex 32>      (KHÔNG xoay được: đổi = mất chống trùng cho lead cũ)
LEADS_CAPTURE_ENABLED=
# Xuất khách tiềm năng CSV/XLSX (LEADS-EXPORT, FR-082, Q-LEX1) — CHỈ tên biến; cờ MẶC ĐỊNH TẮT (chỉ `true`/`false`/trống, giá trị lạ → lỗi cấu hình). PHONE_MODE: hidden | masked (mặc định) | full (chỉ Owner, phải yêu cầu rõ). MAX_ROWS mặc định 5000, trần cứng 20000.
LEADS_EXPORT_ENABLED=
LEADS_EXPORT_PHONE_MODE=
LEADS_EXPORT_MAX_ROWS=

# Xuất dữ liệu workspace (DATA-EXPORT, FR-094, Q-EXP1) — CHỈ tên biến; cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật), đặt cho CẢ web và worker.
# Tệp xuất đã che PII, hết hạn sau 7 ngày. Worker bật thì cần DATA_EXPORT_DIR (thư mục ghi tệp cục bộ, chỉ chủ tiến trình đọc được); chờ object storage + email (DATA-EXPORT-DELIVERY).
DATA_EXPORT_ENABLED=
DATA_EXPORT_DIR=

# PGVECTOR-HYBRID (FR-133): job tạo lại embedding khi đổi mô hình. Cờ MẶC ĐỊNH TẮT (chỉ đúng chữ "true" mới bật); hiện chỉ có embedder mock — KHÔNG bật ở staging/production cho đến khi có embedding thật (KB-EMBED-LITELLM).
KB_REEMBED_ENABLED=

# Tự ẩn SĐT/link (AUTO-HIDE, FR-081, QAH1) — CHỈ tên biến; cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật). AI không bao giờ tự ẩn: quyết định do code.
AUTO_HIDE_ENABLED=
LEADS_ENC_KEYS=
LEADS_HASH_KEY=

# Hạn mức lượt AI/tháng TẠM (FR-090, Q-UMU1) cho đồng hồ lượt; số nguyên >= 0, thiếu/sai -> 500. Bỏ khi có bảng gói cước (PLANS-SCHEMA).
AI_TURNS_PLAN_LIMIT=

# Ô Thử AI hiện đoạn tìm được + điểm từ KB (KB-TRYAI, FR-059). Mặc định TẮT: ô Thử AI dùng kiến thức mẫu. Đặt true để tìm trong phiên bản kiến thức đã xuất bản của workspace (searchKbChunks; embedding vẫn là bản fixture).
TRY_AI_KB_REAL=

# Giới hạn tốc độ gửi theo Page/bài/nội dung lặp (RATE-LIMIT-PAGE, FR-114, Q-RLP1) — CHỈ tên biến; cờ MẶC ĐỊNH TẮT (chỉ đúng chữ `true` mới bật). Số nguyên dương; thiếu/sai -> mặc định docs/09 §11.1 (30/phút, 600/giờ, 60/giờ tự gửi, 20/10 phút/bài, 5 giống hệt/giờ).
SEND_RATE_LIMIT_ENABLED=
SEND_RATE_PAGE_PER_MINUTE=
SEND_RATE_PAGE_PER_HOUR=
SEND_RATE_AUTO_PER_HOUR=
SEND_RATE_POST_PER_10MIN=
SEND_RATE_REPEAT_PER_HOUR=
SHOPIFY_ENABLED=            # worker: BẬT = đọc sản phẩm/tồn/chính sách Shopify thật qua Admin GraphQL chỉ đọc (SHOPIFY-IMPORT, FR-052); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; bật thì cần SHOPIFY_API_SECRET (kèm kết nối cửa hàng — chưa có, làn b)
SHOPIFY_API_VERSION=        # phiên bản Admin API đã ghim, dạng YYYY-MM (01/04/07/10); trống = mặc định trong code; kiểm lại trên tài liệu Shopify
HARAVAN_ENABLED=            # worker: BẬT = đọc sản phẩm/tồn Haravan thật qua Omni API chỉ đọc (SRC-HARAVAN, FR-122); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; cần kết nối cửa hàng/token (chưa có, làn b)
HARAVAN_APP_SECRET=         # Client secret của Haravan app: chỉ để xác minh chữ ký webhook (X-Haravan-Hmac-Sha256); không bao giờ commit
SAPO_ENABLED=               # worker: BẬT = đọc sản phẩm/tồn Sapo thật qua Sapo Web API chỉ đọc (SRC-SAPO, FR-122); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; cần kết nối cửa hàng/token (chưa có, làn b)
SAPO_APP_SECRET=            # Client secret của Sapo app: chỉ để xác minh chữ ký webhook (X-Sapo-Hmac-Sha256); không bao giờ commit
KIOTVIET_ENABLED=           # worker: BẬT = đọc sản phẩm/tồn KiotViet thật qua Public API chỉ đọc (SRC-KIOTVIET, FR-122); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; cần kết nối cửa hàng + Client ID/Secret theo workspace (chưa có, làn b)
KIOTVIET_WEBHOOK_SECRET=    # Bí mật đăng ký webhook KiotViet: chỉ để xác minh chữ ký (X-Hub-Signature); không bao giờ commit
PANCAKE_ENABLED=            # worker: BẬT = đọc sản phẩm/tồn Pancake POS thật qua Open API chỉ đọc (SRC-PANCAKE, FR-122); MẶC ĐỊNH TẮT, chỉ đúng chữ `true` mới bật; cần kết nối shop + API key theo workspace (chưa có, làn b)
SHOPIFY_API_SECRET=         # Client secret của Shopify app: chỉ để xác minh chữ ký webhook (X-Shopify-Hmac-Sha256); không bao giờ commit

# Xac nhan thanh toan tu dong (AUTO-PAYMENT-CONFIRM, FR-124; web): co MAC DINH TAT (chi dung chu true moi bat). Khoa do SePay/Casso cap khi chu du an dang ky (docs/CAN_BAN_CUNG_CAP.md). Webhook: /api/webhooks/payments/sepay va /casso. Co PAYMENT_ACCOUNT_NUMBER thi giao dich vao tai khoan khac bi bo qua.
BANK_WEBHOOK_ENABLED=
# Khoa API SePay (tieu de Authorization: Apikey <khoa>)
SEPAY_WEBHOOK_API_KEY=
# Secure token Casso (tieu de secure-token)
CASSO_WEBHOOK_SECURE_TOKEN=
# Thong bao day PWA + email (FR-084). Mac dinh TAT
PUSH_EMAIL_ENABLED=
# Cap khoa VAPID cho Web Push (RFC 8292) - dat ca bo hoac de trong
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# mailto:... hoac https://... lien he van hanh
WEB_PUSH_SUBJECT=
